# ── Secretos / credenciales — NUNCA subir ──
.api_key
woo_config.json
woo_pub.json

# ── Runtime / generados ──
# pedidos/ = kits generados (datos de clientes); salida/ = previews/output
pedidos/
salida/
# cache de miniaturas de la tienda (regenerable, se re-warmea solo)
.cache/
# carpeta de subidas manuales al server (scratch, ej: arte que pasa Pablo por scp)
entrada/
__pycache__/
*.pyc

# ── Cachés del cuaderno + staging del motor IA (regenerables, NO versionar) ──
temas/*/actividades_cache/
temas/*/actividades_mon/
temas/*/actividades_preview/
temas/*/actividades_cards/
temas/*/ia_draft/
temas/*/ia_maestra.png
temas/*/invitacion_web_hero.png
temas/*/stl3d_cache/
# hoja de stickers recompuesta (cache regenerable)
temas/*/extras/.stickers_uniforme.png
.thumbs/

# ── Dependencias regenerables (npm install) ──
node_modules/

# invitaciones web interactivas (datos de eventos en runtime, vigencia 180d)
invitaciones/

# audiolibros web (datos de pedidos en runtime, vigencia 365d)
audiolibros/

# actividades web interactivas (datos de pedidos en runtime)
actividades/
# rompecabezas web interactivos (carpetas por token, datos de pedidos en runtime)
rompecabezas_web/
# rompecabezas-foto: fotos subidas ANTES de pagar, staging temporal (2h)
_rompecabezas_foto_staging/
# mándalas web para pintar (carpetas por token: kit.zip + portada, datos de compra)
mandalas_web/
# "elegí tu aventura" — prototipo (carpetas por token: manifest.json, datos de compra/demo)
aventura_web/
temas/*/audiolibro_demo.txt

# cache de arte del catálogo de audiolibros (generar una vez -> revisar -> reusar)
catalogo_arte/
# indicaciones del editor por tema (contenido operativo, no código)
temas/*/libro_notas.txt
temas/*/audiolibro_demo_*.txt
# PDFs prearmados de libros genéricos (artefactos: se regeneran del cache con
# prebuild_pdfs; ~120MB que no van al repo)
libros_pdf/
.claude/worktrees/

# cache runtime de TTS on-demand (voz argentina de explicaciones/consignas dinámicas)
audio_dinamico/

# activación escalable: solicitudes de desbloqueo de nivel (datos runtime)
datos_premium/
